# frostd address as host:port (frost-client always uses HTTPS), e.g. a cloudflared quick tunnel
FROSTD_URL=your-tunnel.trycloudflare.com:443
# Optional: Telegram bot from @BotFather for check-in reminders and guardian alerts
TELEGRAM_BOT_TOKEN=
# Where the PWA runs (used in Telegram deep links)
APP_URL=http://localhost:3001
PORT=8787
# Optional overrides
# ZECHEIR_DATA_DIR=../data
# ZECHEIR_BIN_DIR=../tools/bin
# ZECHEIR_LWD_SERVER=zecrocks
# ZECHEIR_DEBUG=1
